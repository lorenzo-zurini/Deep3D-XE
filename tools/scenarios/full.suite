ui_remastered       ui.scn        graphics.enhanced=true graphics.remastered=true
ui_phone_original   ui.scn        graphics.enhanced=false graphics.original_screen=phone
flight_rm_noaa_16bit flight.scn   graphics.enhanced=true graphics.remastered=true graphics.antialiasing=false graphics.full_colour=false display.texture_filter=false
flight_rm_fov100    flight.scn    graphics.enhanced=true graphics.remastered=true display.fov=100
art_remastered      art.scn       graphics.enhanced=true graphics.remastered=true
reach_remastered    reach.scn     graphics.enhanced=true graphics.remastered=true
mouse_remastered    mouse.scn     graphics.enhanced=true graphics.remastered=true
mouse_original      mouse.scn     graphics.enhanced=false
lights_remastered   lights.scn    graphics.enhanced=true graphics.remastered=true
